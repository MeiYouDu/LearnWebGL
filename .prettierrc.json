{
	"plugins": [
		"prettier-plugin-tailwindcss",
		"prettier-plugin-glsl",
		"prettier-plugin-organize-imports"
	],
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"endOfLine": "auto",
	"bracketSameLine": true,
	"jsxBracketSameLine": true,
	"printWidth": 100
}
